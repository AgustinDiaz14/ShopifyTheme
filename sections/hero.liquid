<section id="{{ section.id }}" class="hero-video">
    {{ section.settings.video_file | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'hero-video__video' }}

    {% if section.settings.show_overlay %}
        <div class="hero-video__overlay" style="opacity: {{ section.settings.overlay_opacity }};"></div>
    {% endif %}

    <div class="hero-video__inner">
        <h1 class="hero-video__heading">{{ section.settings.heading }}</h1>

        {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
            <a href="{{ section.settings.cta_link }}" class="hero-video__btn">
                {{ section.settings.cta_label }}
            </a>
        {% endif %}
    </div>
</section>

{% schema %}
{
  "name": "Hero video",
  "tag": "section",
  "class": "hero-video",
  "settings": [
    {
      "type": "video",
      "id": "video_file",
      "label": "Background video"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Mostrar overlay oscuro",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad del overlay",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Great things never came from comfort zones."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto del botón",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del botón"
    }
  ],
  "presets": [
    {
      "name": "Hero video"
    }
  ]
}
{% endschema %}
