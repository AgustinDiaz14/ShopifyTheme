<section class="goals-section">
    <div class="goals-header">
        <p class="goals-pretitle">{{ section.settings.pretitle }}</p>
        <h2 class="goals-title">{{ section.settings.title }}</h2>
        <p class="goals-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="goals-grid">
        {% for block in section.blocks %}
            <div class="goal-card">
                <div class="goal-image-wrapper">
                    {% if block.settings.image %}
                        <img
                                src="{{ block.settings.image | image_url: width: 800, format: 'webp' }}"
                                alt="{{ block.settings.heading }}"
                                class="{% if block.settings.flip_image %}flipped-image{% endif %} goal-image"
                                style="object-position: {{ block.settings.position_x }}% {{ block.settings.position_y }}%;"
                                loading="lazy"
                                decoding="async"

                        >
                    {% endif %}
                </div>

                <div class="goal-card-content">
                    <div>
                        <h3>{{ block.settings.heading }}</h3>
                        <p>{{ block.settings.description }}</p>
                    </div>
                    <div class="goal-card-arrow">
                        <img src="{{ 'circle-arrow.svg' | asset_url }}" alt="Circle Arrow" class="arrow-icon">
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
{% schema %}
{
  "name": "Goals Section",
  "settings": [
    {
      "type": "text",
      "id": "pretitle",
      "label": "Pretitle",
      "default": "Comfortably Uncomfortable"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Start with your Goals"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We cannot become what we want to be by remaining what we are."
    }
  ],
  "blocks": [
    {
      "type": "goal_card",
      "name": "Goal Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Sleep"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Optimize your sleep patterns."
        },
        {
          "type": "checkbox",
          "id": "flip_image",
          "label": "Flip image horizontally",
          "default": false
        },
        {
          "type": "range",
          "id": "position_x",
          "label": "Image Horizontal Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "Image Vertical Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Goals Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}