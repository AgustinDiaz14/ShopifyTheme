<header class="main-header">
    <input type="checkbox" id="menu-toggle" class="menu-toggle" hidden>
    <label for="menu-toggle" class="hamburger">
        <span></span>
        <span></span>
        <span></span>
    </label>
    <nav class="navbar">

        <a href="{{ routes.root_url }}" class="logo">
            {% if section.settings.logo != blank %}
                {{ section.settings.logo | image_url: width: 160 | image_tag: class: 'main-header__logo-img', alt: section.settings.logo.alt | default: shop.name }}
            {% else %}
                {{ section.settings.logo_text }}
            {% endif %}
        </a>

        {% if section.settings.menu != blank %}
            <div class="main-header__nav">
                <ul>
                    <li>
                        <a href="#" class="menu-link">
                            <img src="{{ 'search-logo.svg' | asset_url }}" class="search-logo" alt="Search"/>
                        </a>
                    </li>
                    {% for link in linklists[section.settings.menu].links %}
                        <li class="menu-item"><a class="menu-link" href="{{ link.url }}">{{ link.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="main-header__right">
            <div class="gender-toggle">
                <input type="checkbox" id="gender-toggle-checkbox" class="gender-toggle__checkbox" hidden>
                <label for="gender-toggle-checkbox" class="gender-toggle__label">
                    <span class="gender-toggle__content">
                        <span class="gender-toggle__icon icon-men">
                            <img src="{{ section.settings.icon_men | image_url: width: 24 }}" alt="Men">
                        </span>
                        <span class="gender-toggle__text gender-men">MEN</span>
                        <span class="gender-toggle__icon icon-women">
                            <img src="{{ section.settings.icon_women | image_url: width: 24 }}" alt="Women">
                        </span>
                        <span class="gender-toggle__text gender-women">WOMEN</span>
                    </span>
                </label>
            </div>


            <a href="#" class="main-header__btn main-header__btn--dark">Take The Quiz</a>
            <a href="/#" class="main-header__icon">
                <img src="{{ 'person-icon.svg' | asset_url }}" alt="Person Icon" >
            </a>
            <a href="/#" class="main-header__icon">
                <img src="{{ 'cart-icon.svg' | asset_url }}" alt="Person Icon">
            </a>
        </div>
    </nav>
</header>


{% schema %}
{
  "name": "Header",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Text Logo (used if no logo image is set)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu"
    },
    {
      "type": "image_picker",
      "id": "icon_men",
      "label": "Men Icon"
    },
    {
      "type": "image_picker",
      "id": "icon_women",
      "label": "Women Icon"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}

