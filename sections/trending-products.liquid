<section class="trending-products-section">
    <div class="container">
        {% assign categories = section.blocks | map: 'settings.category' | uniq %}

        {% for category_name in categories %}
            <div class="category-section category-{{ category_name | handle }}">
                <div class="category-header">
                    <h2>{{ category_name }}</h2>
                </div>

                <div class="products-grid">
                    {% for block in section.blocks %}
                        {% if block.settings.category == category_name %}
                            {% render 'product-card',
                                    product: all_products[block.settings.product],
                                    bestseller: block.settings.bestseller,
                                    badges: block.settings.badges %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</section>


{% schema %}
{
  "name": "Trending Products",
  "settings": [],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": "Supplements"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "bestseller",
          "label": "Show Bestseller Badge",
          "default": false
        },
        {
          "type": "textarea",
          "id": "badges",
          "label": "Tags (comma separated)",
          "default": "Vegan, Dairy Free"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trending Products"
    }
  ]
}
{% endschema %}
