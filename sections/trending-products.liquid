        },
        {
          "type": "checkbox",
          "id": "bestseller_2",
          "label": "Bestseller for Product 2",
          "default": false
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "checkbox",
          "id": "bestseller_3",
          "label": "Bestseller for Product 3",
          "default": false
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "checkbox",
          "id": "bestseller_4",
          "label": "Bestseller for Product 4",
          "default": false
        }
