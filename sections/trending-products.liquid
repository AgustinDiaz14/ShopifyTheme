<section class="trending-products-section">
  <div class="container">

    <div class="slider-header">
      <button class="slider-arrow" data-direction="prev">{{ 'left-arrow.svg' | asset_url | img_tag }}</button>

      <div class="slider-title">
        <h3>🌟 Trending</h3>
        <h2 class="slider-collection-title"></h2>
        <a href="#" class="slider-view-all">View All</a>
      </div>

      <button class="slider-arrow" data-direction="next">{{ 'right-arrow.svg' | asset_url | img_tag }}</button>
    </div>

    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      <div class="collection-section" data-title="{{ collection.title | escape }}" style="display: none;">
        <div class="products-grid">
          {% assign selected_products = '' %}
          {% assign selected_bestsellers = '' %}

          {% for i in (1..4) %}
            {% assign product_id = 'product_' | append: i %}
            {% assign bestseller_id = 'bestseller_' | append: i %}
            {% assign handle = block.settings[product_id] %}

            {% if handle != blank %}
              {% assign selected_products = selected_products | append: handle | append: ',' %}
              {% assign selected_bestsellers = selected_bestsellers | append: block.settings[bestseller_id] | append: ',' %}
            {% endif %}
          {% endfor %}

          {% assign product_list = selected_products | split: ',' %}
          {% assign bestseller_list = selected_bestsellers | split: ',' %}

          {% for product_handle in product_list %}
            {% assign index = forloop.index0 %}
            {% assign product = all_products[product_handle] %}
            {% assign is_bestseller = bestseller_list[index] %}
            {% assign is_bestseller = is_bestseller | downcase %}
            {% if is_bestseller == 'true' %}
              {% assign is_product_bestseller = true %}
            {% else %}
              {% assign is_product_bestseller = false %}
            {% endif %}


            {% if product %}
              {% render 'product-card',
                      product: product,
                      bestseller: is_product_bestseller %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{{ 'trending-products.js' | asset_url | script_tag }}

