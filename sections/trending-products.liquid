<section class="trending-products-section">
  <div class="container">

    {%- assign categories = "" -%}
    {%- for block in section.blocks -%}
      {%- assign cat = block.settings.category | strip -%}
      {%- unless categories contains cat -%}
        {%- assign categories = categories | append: cat | append: "||" -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- assign category_list = categories | split: "||" -%}

    {% for cat in category_list %}
      <div>
        <div class="category-header">
          <h2>{{ cat }}</h2>
        </div>

        <div class="products-grid">
          {% for block in section.blocks %}
            {% if block.settings.category == cat %}
              {% assign product = all_products[block.settings.product] %}
              {% if product %}
                {% render 'product-card', product: product %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Trending Products",
  "settings": [],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "bestseller",
          "label": "Show Bestseller Badge",
          "default": false
        },
        {
          "type": "textarea",
          "id": "badges",
          "label": "Tags (comma separated)",
          "default": "Vegan, Dairy Free"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trending Products"
    }
  ]
}
{% endschema %}
