<section class="bundle-products-section">
    <div class="container">

        <div class="slider-header">
            <div class="bundle-slider-title-container">
                <p>{{ 'bundle.title_icon' | t }}</p>
                <h2>{{ 'bundle.title_heading' | t }}</h2>
            </div>

            <div class="bundle-collection-container">
                {% for block in section.blocks %}
                    {% assign collection = block.settings.collection %}
                    <a href="{{ block.settings.link }}" target="_blank" class="bundle-nav-link">{{ collection.title }}</a>
                {% endfor %}
            </div>

            <div class="bundle-slider-nav">
                <a href="#">{{ 'bundle.view_all' | t }}</a>
                <button class="slider-arrow" data-direction="prev" aria-label="{{ 'bundle.slider_prev_aria' | t }}">
                    {{ 'left-arrow.svg' | asset_url | img_tag }}
                </button>
                <button class="slider-arrow" data-direction="next" aria-label="{{ 'bundle.slider_next_aria' | t }}">
                    {{ 'right-arrow.svg' | asset_url | img_tag }}
                </button>
            </div>
        </div>

        {% for block in section.blocks %}
            {% assign collection = block.settings.collection %}
            <div class="bundle-collection-section" data-title="{{ collection.title | escape }}">
                <div class="bundle-products-grid">
                    {% assign selected_products = '' %}
                    {% assign selected_bestsellers = '' %}

                    {% for i in (1..4) %}
                        {% assign product_id = 'bundle_product_' | append: i %}
                        {% assign bestseller_id = 'bundle_bestseller_' | append: i %}
                        {% assign handle = block.settings[product_id] %}

                        {% if handle != blank %}
                            {% assign selected_products = selected_products | append: handle | append: ',' %}
                            {% assign selected_bestsellers = selected_bestsellers | append: block.settings[bestseller_id] | append: ',' %}
                        {% endif %}
                    {% endfor %}

                    {% assign product_list = selected_products | split: ',' %}
                    {% assign bestseller_list = selected_bestsellers | split: ',' %}

                    {% for product_handle in product_list %}
                        {% assign index = forloop.index0 %}
                        {% assign product = all_products[product_handle] %}
                        {% assign is_bestseller = bestseller_list[index] %}
                        {% assign is_bestseller = is_bestseller | downcase %}
                        {% if is_bestseller == 'true' %}
                            {% assign is_product_bestseller = true %}
                        {% else %}
                            {% assign is_product_bestseller = false %}
                        {% endif %}


                        {% if product %}
                            {% render 'product-card',
                                    product: product,
                                    bestseller: is_product_bestseller %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</section>

{% schema %}
{
  "name": "Bundle Products",
  "settings": [],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Products",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Choose collection"
        },
        {
          "type": "product",
          "id": "bundle_product_1",
          "label": "Product 1"
        },
        {
          "type": "checkbox",
          "id": "bundle_bestseller_1",
          "label": "Bestseller for Product 1",
          "default": false
        },
        {
          "type": "product",
          "id": "bundle_product_2",
          "label": "Product 2"
        },
        {
          "type": "checkbox",
          "id": "bundle_bestseller_2",
          "label": "Bestseller for Product 2",
          "default": false
        },
        {
          "type": "product",
          "id": "bundle_product_3",
          "label": "Product 3"
        },
        {
          "type": "checkbox",
          "id": "bundle_bestseller_3",
          "label": "Bestseller for Product 3",
          "default": false
        },
        {
          "type": "product",
          "id": "bundle_product_4",
          "label": "Product 4"
        },
        {
          "type": "checkbox",
          "id": "bundle_bestseller_4",
          "label": "Bestseller for Product 4",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trending Products",
      "blocks": []
    }
  ]
}
{% endschema %}
