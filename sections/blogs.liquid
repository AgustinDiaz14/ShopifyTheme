{% assign blog = blogs['news'] %}
<section class="latest-articles">
    <div class="blogs-header">
        <div>
            <h3>{{ 'blogs.title_icon' | t }}</h3>
            <h2>{{ 'blogs.title_heading' | t }}</h2>
        </div>
        <a href="#" class="view-all">{{ 'blogs.view_all' | t }}</a>
    </div>


    <div class="articles-container">
        <div class="featured">
            {% assign first_article = blog.articles[0] %}
            <img src="{{ first_article.image | image_url: width: 800 }}" alt="{{ first_article.title }}">
            <div class="featured-article-content">
                <p class="category">{{ first_article.tags[0] }}</p>
                <h3>{{ first_article.title }}</h3>
                <p>By {{ first_article.author }} | {{ first_article.published_at | date: "%B %d, %Y" }}</p>
            </div>
        </div>

        <div class="side-articles">
            {% for article in blog.articles offset: 1 limit: 2 %}
                <div class="article-card">
                    <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title }}">
                    <div class="article-content">
                        <p class="category">{{ article.tags[0] }}</p>
                        <h3>{{ article.title }}</h3>
                        <p>By {{ article.author }} | {{ article.published_at | date: "%B %d, %Y" }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
