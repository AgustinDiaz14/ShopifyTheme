{% comment %}Since the website is not completed all links will be hardcoded to "#"{% endcomment %}

<footer class="custom-footer">
    <div class="footer__top">
        <!-- Newsletter -->
        <div class="footer__newsletter">
            <h3>{{ 'footer.newsletter_heading' | t }}</h3>
            <p>{{ 'footer.newsletter_description' | t }}</p>
            {% comment %}This form will not take you anywhere for the same reason above{% endcomment %}
            <form class="footer__form">
                <input type="email" name="contact[email]" placeholder="Email Address" required>
                <button type="submit">{{ 'footer.subscribe_button' | t }}</button>
            </form>
        </div>

        <!-- Link Columns -->
        <div class="footer__links">
            <div class="footer__column">
                <h4>{{ 'footer.column_about' | t }}</h4>
                <ul>
                    <li><a href="/blogs/news">Blog</a></li>
                    <li><a href="/pages/reviews">Product Reviews</a></li>
                    <li><a href="/pages/about">Our Story</a></li>
                    <li><a href="/pages/delivery">Delivery</a></li>
                </ul>
            </div>
            <div class="footer__column">
                <h4>{{ 'footer.column_support' | t }}</h4>
                <ul>
                    <li><a href="/pages/order-status">Order Status</a></li>
                    <li><a href="/pages/help-center">Help Center</a></li>
                    <li><a href="/pages/contact">Contact Us</a></li>
                    <li><a href="/pages/returns">Returns</a></li>
                </ul>
            </div>
            <div class="footer__column">
                <h4>{{ 'footer.column_links' | t }}</h4>
                <ul>
                    <li><a href="/pages/maintenance">Maintenance</a></li>
                    <li><a href="/pages/warranty">Warranty</a></li>
                    <li><a href="/pages/canadian-customers">Canadian Customers</a></li>
                    <li><a href="/pages/setup">Setup</a></li>
                </ul>
            </div>
            <div class="footer__column">
                <h4>{{ 'footer.column_legal' | t }}</h4>
                <ul>
                    <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
                    <li><a href="/pages/accessibility">Accessibility</a></li>
                    <li><a href="/policies/terms-of-service">Terms of Service</a></li>
                    <li><a href="/pages/affiliate-program">Affiliate Program</a></li>
                    <li><a href="/blogs/articles">Articles</a></li>
                </ul>
            </div>
        </div>

        <!-- Contact / Social -->
        <div class="footer__contact">
            <h4>{{ 'footer.column_contact' | t }}</h4>
            <p>{{ 'footer.contact_helper' | t }}</p>
            <p class="footer__phone"><strong>(888) 860-0572</strong></p>
            <h4>{{ 'footer.column_connect' | t }}</h4>
            <div class="footer__social">
                <a href="#"><i class="fa-brands fa-instagram"></i></a>
                <a href="#"><i class="fa-brands fa-twitter"></i></a>
                <a href="#"><i class="fa-brands fa-facebook"></i></a>
                <a href="#"><i class="fa-brands fa-youtube"></i></a>
            </div>
        </div>
    </div>

    <!-- Bottom -->
    <div class="footer__bottom">
        <p>{{ 'footer.bottom_copyright' | t }}</p>
        <p>{{ 'footer.bottom_made_with' | t }}</p>
    </div>
</footer>
