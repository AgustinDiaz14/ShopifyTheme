<div id="quick-view-modal" class="quick-view-modal" hidden>
    <div class="quick-view-content">
        <button class="close-modal">×</button>
        <div class="modal-body">
            <img id="quick-view-image" src="" alt="" />
            <h2 id="quick-view-title"></h2>
            <p id="quick-view-price"></p>
            <p id="quick-view-description"></p>
            <form id="quick-view-form">
                <input type="hidden" name="id" id="quick-view-variant-id">
                <button type="submit">Add to Cart</button>
            </form>
        </div>
    </div>
</div>