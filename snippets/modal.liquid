<div id="quick-view-modal" class="quick-view-drawer">
    <div class="drawer-content">
        <button class="drawer-close">×</button>

        <div class="drawer-product">
            <img id="quick-view-image" src="" alt="Product image" />
            <div class="product-details">
                <h2 id="quick-view-title">Product Name</h2>
                <p id="quick-view-description">Short description</p>

                <div class="product-tags">
                    <span class="tag">GMO Free</span>
                    <span class="tag">Gluten Free</span>
                </div>

                <!-- Tu tabla -->
                <table class="variant-table">
                    <thead>
                    <tr>
                        <th>Variant</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Total</th>
                    </tr>
                    </thead>
                    <tbody id="variant-table">
                    <!-- JS inyecta filas acá -->
                    </tbody>
                </table>

                <template id="variant-row-template">
                    <tr>
                        <td class="variant-col">
                            <div class="variant-info">
                                <img class="variant-image" src="" alt="">
                                <div class="variant-title-group">
                                    <strong class="variant-size"></strong><br>
                                    <small class="variant-label"></small>
                                </div>
                            </div>
                        </td>
                        <td class="variant-qty">
                            <button class="qty-minus">−</button>
                            <input type="number" value="0" min="0" class="variant-input"/>
                            <button class="qty-plus">+</button>
                        </td>
                        <td class="variant-price"></td>
                        <td class="variant-total">$0.00</td>
                    </tr>
                </template>


                {% comment %}As I am not sure of this implementation based on the design, I just hardcoded it{% endcomment %}
                <div class="purchase-options">
                    <div class="option-container">
                        <div class="flex flex-column">
                            <label>
                                <input type="radio" name="purchase_type" checked />
                                One-Time Purchase
                            </label>
                            <p class="price-text">$49.95</p>
                            <p class="auxiliary-text">Delivery Every 2 Months</p>
                        </div>
                    </div>
                    <div class="option-container">
                        <div class="flex flex-column">
                            <label>
                                <input type="radio" name="purchase_type" checked />
                                Subscribe & Save
                            </label>
                            <div class="flex items-center">
                                <p class="price-text">$39.96</p>
                                <p class="discount-text">Save 10%</p>
                            </div>
                            <p class="auxiliary-text">Delivery Every 2 Months</p>
                        </div>
                    </div>
                </div>

                <div class="add-to-cart-button-container flex">
                    <div class="quantity-controls">
                        <button id="qty-minus">–</button>
                        <input type="number" id="quick-view-qty" value="1" min="1" />
                        <button id="qty-plus">+</button>
                    </div>

                    <form id="quick-view-form">
                        <input type="hidden" name="id" id="quick-view-variant-id">
                        <button type="submit" class="add-to-cart">Add to Cart – <span id="quick-view-price">$0.00</span></button>
                    </form>
                </div>

                <a href="#" id="view-full-details">View Full Details</a>
            </div>
        </div>
    </div>
</div>
